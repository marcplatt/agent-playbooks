{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-playbooks/hrm-dispatch-envelope.schema.json",
  "title": "Compiled HRM worker dispatch envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "hrm_id",
    "capsule_sha256",
    "ledger_cursor",
    "cache",
    "assignment",
    "scope",
    "authority",
    "protocol",
    "dispatch_hash"
  ],
  "properties": {
    "schema_version": {"const": "agent_playbooks.hrm_dispatch_envelope.v0.3"},
    "session_id": {"$ref": "#/$defs/nonempty"},
    "hrm_id": {"$ref": "#/$defs/nonempty"},
    "capsule_sha256": {"$ref": "#/$defs/sha256"},
    "ledger_cursor": {"type": "integer", "minimum": 0},
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_key", "kernel_key", "target_contract_key", "load_policy"],
      "properties": {
        "cache_key": {"$ref": "#/$defs/sha256"},
        "kernel_key": {"$ref": "#/$defs/sha256"},
        "target_contract_key": {"$ref": "#/$defs/sha256"},
        "load_policy": {"const": "hashes_only_unless_changed"}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_action",
        "action",
        "role",
        "required_dependency_ids",
        "dependencies",
        "role_context_budget_bytes",
        "loaded_artifact_budget_bytes",
        "tool_output_reserve_bytes",
        "load_policy"
      ],
      "properties": {
        "next_action": {"$ref": "#/$defs/nonempty"},
        "action": {"type": ["string", "null"], "minLength": 1},
        "role": {
          "type": ["string", "null"],
          "enum": ["orchestrator", "builder", "checker", "provider_observer", "reviewer", null]
        },
        "required_dependency_ids": {"$ref": "#/$defs/string_array"},
        "dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/assignment_dependency"}
        },
        "role_context_budget_bytes": {"type": "integer", "minimum": 0},
        "loaded_artifact_budget_bytes": {"type": "integer", "minimum": 0},
        "tool_output_reserve_bytes": {"type": "integer", "minimum": 0},
        "load_policy": {"const": "bounded_queries_never_full_source"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "deliverable_type",
        "required_dependency_ids",
        "declared_dependency_ids",
        "required_skill_ids",
        "missing_skill_ids",
        "required_real_seams",
        "missing_runtime_bindings",
        "allowed_paths",
        "proof_obligations",
        "exact_checks"
      ],
      "properties": {
        "execution_mode": {"$ref": "#/$defs/nonempty"},
        "deliverable_type": {"$ref": "#/$defs/nonempty"},
        "required_dependency_ids": {"$ref": "#/$defs/string_array"},
        "declared_dependency_ids": {"$ref": "#/$defs/string_array"},
        "required_skill_ids": {"$ref": "#/$defs/string_array"},
        "missing_skill_ids": {"$ref": "#/$defs/string_array"},
        "required_real_seams": {"$ref": "#/$defs/string_array"},
        "missing_runtime_bindings": {"$ref": "#/$defs/string_array"},
        "allowed_paths": {"$ref": "#/$defs/string_array"},
        "proof_obligations": {"$ref": "#/$defs/string_array"},
        "exact_checks": {"$ref": "#/$defs/string_array"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routine_action_authorized", "enabled_operational_effects"],
      "properties": {
        "routine_action_authorized": {"type": "boolean"},
        "enabled_operational_effects": {"$ref": "#/$defs/string_array"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_command",
        "context_command",
        "guard_command",
        "result_command",
        "context_report",
        "result_contract"
      ],
      "properties": {
        "working_directory": {"type": "string", "minLength": 1},
        "handoff_command": {"$ref": "#/$defs/nullable_command"},
        "context_command": {"$ref": "#/$defs/nullable_command"},
        "guard_command": {"$ref": "#/$defs/nullable_command"},
        "result_command": {"$ref": "#/$defs/nullable_command"},
        "worker_execution_order": {
          "const": ["bounded_source_materialization", "context", "guard", "result"]
        },
        "zero_artifact_preflight": {
          "const": "optional_and_ignored_for_artifact_identity_and_redundancy"
        },
        "context_report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stdin",
            "required_fields",
            "optional_nonnegative_integer_fields",
            "measurement_scope",
            "dependency_output_accounting",
            "source_size_bounds_enforced",
            "platform_instructions",
            "machine_parsed_dispatch_echo_bytes"
          ],
          "properties": {
            "stdin": {"const": "json"},
            "required_fields": {"$ref": "#/$defs/string_array"},
            "optional_nonnegative_integer_fields": {"$ref": "#/$defs/string_array"},
            "measurement_scope": {"const": "nonoverlapping_loaded_artifact_and_nondependency_tool_output_bytes"},
            "dependency_output_accounting": {"const": "exclude_from_tool_output_bytes"},
            "source_size_bounds_enforced": {"const": true},
            "platform_instructions": {"const": "excluded"},
            "machine_parsed_dispatch_echo_bytes": {"const": 0}
          }
        },
        "result_contract": {"const": "append_compact_events_only"}
      }
    },
    "dispatch_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nullable_command": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    },
    "assignment_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "kind", "source_path", "source_size_bytes", "access_policy"],
      "properties": {
        "dependency_id": {"$ref": "#/$defs/nonempty"},
        "kind": {"$ref": "#/$defs/nonempty"},
        "source_path": {"$ref": "#/$defs/nonempty"},
        "source_size_bytes": {"type": "integer", "minimum": 0},
        "access_policy": {"const": "targeted_queries_and_bounded_slices"}
      }
    }
  }
}
