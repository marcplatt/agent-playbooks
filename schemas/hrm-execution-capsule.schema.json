{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-playbooks/hrm-execution-capsule.schema.json",
  "title": "HRM execution capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "playbook_pin",
    "system_reference",
    "project_root",
    "repository_bases",
    "target_resolution",
    "session_lineage",
    "entry_condition",
    "hrm",
    "experiment_profile",
    "execution_mode",
    "deliverable_type",
    "function_slice",
    "project_api_skills",
    "context_dependencies",
    "workflow_lease",
    "role_topology",
    "authority",
    "verification",
    "reference_requests",
    "budgets",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "agent_playbooks.hrm_execution_capsule.v0.7"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "playbook_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel_id", "kernel_version", "source_sha"],
      "properties": {
        "kernel_id": {"const": "AP-EXEC-001"},
        "kernel_version": {"const": "0.1.0-rc.11"},
        "source_sha": {"$ref": "#/$defs/sha"}
      }
    },
    "system_reference": {"$ref": "#/$defs/nonempty"},
    "project_root": {"$ref": "#/$defs/nonempty"},
    "repository_bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "base_sha"],
        "properties": {
          "repository": {"$ref": "#/$defs/nonempty"},
          "base_sha": {"$ref": "#/$defs/sha"}
        }
      }
    },
    "target_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_version",
        "source_status",
        "current_target_hrm",
        "method",
        "resolved_hrm_id",
        "explicit_hrm_id"
      ],
      "properties": {
        "source_path": {"$ref": "#/$defs/nonempty"},
        "source_version": {"$ref": "#/$defs/nonempty"},
        "source_status": {"const": "accepted"},
        "current_target_hrm": {"$ref": "#/$defs/nonempty"},
        "method": {"enum": ["derived_current", "explicit_exact_override"]},
        "resolved_hrm_id": {"$ref": "#/$defs/nonempty"},
        "explicit_hrm_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "session_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_session_id",
        "capsule_sequence",
        "continuation_reason",
        "inherited_state_path",
        "predecessor_event_log_path",
        "predecessor_event_log_sha256",
        "decision_receipts"
      ],
      "properties": {
        "predecessor_session_id": {"type": ["string", "null"], "minLength": 1},
        "capsule_sequence": {"type": "integer", "minimum": 1},
        "continuation_reason": {
          "enum": [
            "initial",
            "playbook_changed",
            "target_changed",
            "contract_changed",
            "function_slice_changed",
            "execution_mode_changed"
          ]
        },
        "inherited_state_path": {"type": ["string", "null"], "minLength": 1},
        "predecessor_event_log_path": {"type": ["string", "null"], "minLength": 1},
        "predecessor_event_log_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "decision_receipts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision_id",
              "request_session_id",
              "request_sequence",
              "request_event_sha256",
              "decision_kind",
              "effect_class"
            ],
            "properties": {
              "decision_id": {"$ref": "#/$defs/nonempty"},
              "request_session_id": {"$ref": "#/$defs/nonempty"},
              "request_sequence": {"type": "integer", "minimum": 1},
              "request_event_sha256": {"$ref": "#/$defs/sha256"},
              "decision_kind": {
                "enum": [
                  "business_meaning",
                  "operator_function_review",
                  "exact_head_merge_release",
                  "external_effect_authority",
                  "hrm_closure"
                ]
              },
              "effect_class": {
                "type": ["string", "null"],
                "enum": [
                  "provider_mutation",
                  "customer_transmission",
                  "money_movement",
                  "credential_mutation",
                  "permission_mutation",
                  "deployment",
                  "activation",
                  "canary_execution",
                  "destructive_action",
                  "autonomy",
                  null
                ]
              }
            }
          }
        }
      }
    },
    "entry_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_missing_deliverable_types", "on_mode_mismatch"],
      "properties": {
        "known_missing_deliverable_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["runtime_change", "operational_evidence", "review_packet", "executable_contract"]}
        },
        "on_mode_mismatch": {"const": "start_successor_capsule_or_stop_blocked_input"}
      }
    },
    "hrm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract_path",
        "contract_version",
        "outcome",
        "operator_decision",
        "accepted_scenarios"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "contract_path": {"$ref": "#/$defs/nonempty"},
        "contract_version": {"$ref": "#/$defs/nonempty"},
        "outcome": {"$ref": "#/$defs/nonempty"},
        "operator_decision": {"$ref": "#/$defs/nonempty"},
        "accepted_scenarios": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "execution_mode": {
      "enum": ["runtime_build", "production_observation", "discovery", "rollout"]
    },
    "experiment_profile": {
      "enum": ["runtime_build_fast_feedback", "production_observation_fail_closed", "custom"]
    },
    "deliverable_type": {
      "enum": ["runtime_change", "operational_evidence", "review_packet", "executable_contract"]
    },
    "function_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function_ids",
        "required_real_seams",
        "accepted_scenarios",
        "non_goals",
        "allowed_paths",
        "proof_obligations"
      ],
      "properties": {
        "function_ids": {"$ref": "#/$defs/nonempty_string_array"},
        "required_real_seams": {"$ref": "#/$defs/string_array"},
        "accepted_scenarios": {"$ref": "#/$defs/nonempty_string_array"},
        "non_goals": {"$ref": "#/$defs/string_array"},
        "allowed_paths": {"$ref": "#/$defs/string_array"},
        "proof_obligations": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "project_api_skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "registry_path", "required_skills", "reuse_policy"],
      "properties": {
        "registry_id": {"$ref": "#/$defs/nonempty"},
        "registry_path": {"$ref": "#/$defs/nonempty"},
        "required_skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill_id", "contract_fingerprint"],
            "properties": {
              "skill_id": {"$ref": "#/$defs/nonempty"},
              "contract_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "reuse_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["across_hrms", "across_kernel_versions", "volatile_runtime_state"],
          "properties": {
            "across_hrms": {"const": true},
            "across_kernel_versions": {"const": true},
            "volatile_runtime_state": {"const": "action_time_only"}
          }
        }
      }
    },
    "context_dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency_id", "kind", "source_path", "binding"],
        "properties": {
          "dependency_id": {"$ref": "#/$defs/nonempty"},
          "kind": {
            "enum": [
              "repository_dispatcher",
              "execution_capsule",
              "accepted_target_contract",
              "project_api_skill_registry",
              "playbook_kernel",
              "playbook_runtime",
              "run_state",
              "implementation_source",
              "declared_check"
            ]
          },
          "source_path": {"$ref": "#/$defs/nonempty"},
          "binding": {"$ref": "#/$defs/nonempty"}
        }
      }
    },
    "workflow_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "permitted_routine_actions",
        "continue_across_in_scope_change_units",
        "merge_policy",
        "operator_gate_classes",
        "read_only_diagnostic_scope"
      ],
      "properties": {
        "objective": {"const": "advance_to_next_human_gate"},
        "permitted_routine_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "inspect_read_only",
              "inspect_provider_read_only",
              "inventory_runtime_bindings",
              "discover_project_api_skills",
              "manage_task_branch_worktree",
              "implement_frozen_slice",
              "commit_in_scope_changes",
              "publish_or_update_review_pr",
              "run_declared_checks",
              "correct_within_budget",
              "wait_for_declared_checks",
              "prepare_private_inputs",
              "record_operational_evidence",
              "post_authorized_merge_readback"
            ]
          }
        },
        "continue_across_in_scope_change_units": {"const": true},
        "merge_policy": {
          "enum": ["exact_head_operator_release", "repository_preauthorized_exact_head", "never"]
        },
        "operator_gate_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "business_meaning",
              "operator_function_review",
              "exact_head_merge_release",
              "external_effect_authority",
              "hrm_closure"
            ]
          }
        },
        "read_only_diagnostic_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope_id", "systems", "permitted_operations", "stop_conditions"],
          "properties": {
            "scope_id": {"$ref": "#/$defs/nonempty"},
            "systems": {"$ref": "#/$defs/nonempty_string_array"},
            "permitted_operations": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "repository_and_local_state",
                  "provider_health",
                  "provider_configuration",
                  "provider_logs",
                  "authenticated_portal_navigation",
                  "credential_presence_and_validity"
                ]
              }
            },
            "stop_conditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "provider_mutation_required",
                  "customer_transmission_required",
                  "money_movement_required",
                  "credential_mutation_required",
                  "permission_mutation_required",
                  "deployment_or_activation_required",
                  "canary_execution_required",
                  "destructive_action_required",
                  "business_meaning_required"
                ]
              }
            }
          }
        }
      }
    },
    "role_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_role", "orchestrator_mode", "fresh_context_roles", "worker_required_actions"],
      "properties": {
        "root_role": {"const": "orchestrator"},
        "orchestrator_mode": {"const": "coordinate_only"},
        "fresh_context_roles": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["builder", "checker", "provider_observer", "reviewer"]}
        },
        "worker_required_actions": {
          "type": "object",
          "additionalProperties": {"enum": ["builder", "checker", "provider_observer", "reviewer"]}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "operational"],
      "properties": {
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inspect_read_only",
            "inspect_provider_read_only",
            "manage_task_branch_worktree",
            "implement_allowed_paths",
            "commit_changes",
            "publish_review_pr",
            "bounded_ci_correction",
            "run_declared_checks",
            "wait_for_declared_checks",
            "prepare_private_inputs",
            "record_operational_evidence",
            "post_authorized_merge_readback",
            "merge_without_grant"
          ],
          "properties": {
            "inspect_read_only": {"type": "boolean"},
            "inspect_provider_read_only": {"type": "boolean"},
            "manage_task_branch_worktree": {"type": "boolean"},
            "implement_allowed_paths": {"type": "boolean"},
            "commit_changes": {"type": "boolean"},
            "publish_review_pr": {"type": "boolean"},
            "bounded_ci_correction": {"type": "boolean"},
            "run_declared_checks": {"type": "boolean"},
            "wait_for_declared_checks": {"type": "boolean"},
            "prepare_private_inputs": {"type": "boolean"},
            "record_operational_evidence": {"type": "boolean"},
            "post_authorized_merge_readback": {"type": "boolean"},
            "merge_without_grant": {"const": false}
          }
        },
        "operational": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_mutations",
            "customer_transmissions",
            "money_movements",
            "credential_mutations",
            "permission_mutations",
            "deployment",
            "activation",
            "canary_execution",
            "destructive_actions",
            "autonomy"
          ],
          "properties": {
            "provider_mutations": {"type": "boolean"},
            "customer_transmissions": {"type": "boolean"},
            "money_movements": {"type": "boolean"},
            "credential_mutations": {"type": "boolean"},
            "permission_mutations": {"type": "boolean"},
            "deployment": {"type": "boolean"},
            "activation": {"type": "boolean"},
            "canary_execution": {"type": "boolean"},
            "destructive_actions": {"type": "boolean"},
            "autonomy": {"type": "boolean"}
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "environment_id", "ci_plan_hash", "exact_checks", "full_suite_triggers"],
      "properties": {
        "profile": {"enum": ["light", "standard", "full"]},
        "environment_id": {"$ref": "#/$defs/nonempty"},
        "ci_plan_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "exact_checks": {"$ref": "#/$defs/string_array"},
        "full_suite_triggers": {"$ref": "#/$defs/string_array"}
      }
    },
    "reference_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "source_path",
          "source_heading",
          "max_bytes",
          "approved_by",
          "disposition"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/nonempty"},
          "question": {"$ref": "#/$defs/nonempty"},
          "source_path": {"$ref": "#/$defs/nonempty"},
          "source_heading": {"$ref": "#/$defs/nonempty"},
          "max_bytes": {"type": "integer", "minimum": 1},
          "approved_by": {"$ref": "#/$defs/nonempty"},
          "disposition": {"enum": ["pending", "answered", "not_needed", "blocked"]}
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_consecutive_nonruntime_units",
        "max_correction_rounds",
        "no_material_progress_minutes",
        "max_ci_minutes",
        "max_context_redundancy_ratio",
        "max_context_compactions_before_expected_value",
        "max_semantic_readiness_seconds",
        "max_startup_to_worker_handoff_seconds",
        "max_inline_raw_log_bytes",
        "max_state_artifact_echo_bytes",
        "context_bytes_by_role"
      ],
      "properties": {
        "max_consecutive_nonruntime_units": {"type": "integer", "minimum": 0},
        "max_correction_rounds": {"type": "integer", "minimum": 0},
        "no_material_progress_minutes": {"type": "integer", "minimum": 1},
        "max_ci_minutes": {"type": "integer", "minimum": 0},
        "max_context_redundancy_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_context_compactions_before_expected_value": {"type": "integer", "minimum": 0},
        "max_semantic_readiness_seconds": {"type": "integer", "minimum": 1},
        "max_startup_to_worker_handoff_seconds": {"type": "integer", "minimum": 1},
        "max_inline_raw_log_bytes": {"type": "integer", "minimum": 0},
        "max_state_artifact_echo_bytes": {"type": "integer", "minimum": 0},
        "context_bytes_by_role": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orchestrator", "builder", "checker", "provider_observer", "reviewer", "operator"],
          "properties": {
            "orchestrator": {"type": "integer", "minimum": 1},
            "builder": {"type": "integer", "minimum": 1},
            "checker": {"type": "integer", "minimum": 1},
            "provider_observer": {"type": "integer", "minimum": 1},
            "reviewer": {"type": "integer", "minimum": 1},
            "operator": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_root", "event_log_path", "session_state_path", "scorecard_path", "aftercare_window_days"],
      "properties": {
        "artifact_root": {"const": "project_root"},
        "event_log_path": {"$ref": "#/$defs/nonempty"},
        "session_state_path": {"$ref": "#/$defs/nonempty"},
        "scorecard_path": {"$ref": "#/$defs/nonempty"},
        "aftercare_window_days": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonempty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
